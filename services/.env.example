# Sao chep file nay thanh .env, sau do thay tat ca secret bang gia tri ngau nhien.
# Chi dung cac gia tri duoi day cho local training.
POSTGRES_PASSWORD=change-local-postgres-password
AUTH_DB_PASSWORD=change-local-auth-password
ORDER_DB_PASSWORD=change-local-order-password
INVENTORY_DB_PASSWORD=change-local-inventory-password
PAYMENT_DB_PASSWORD=change-local-payment-password
NOTIFICATION_DB_PASSWORD=change-local-notification-password
REDIS_PASSWORD=change-local-redis-password

# HS512 nen dai it nhat 64 byte va giong nhau tren tat ca service.
JWT_SECRET=change-this-to-a-random-secret-with-at-least-64-bytes-0000000000000000

# Shared token cho HTTP/gRPC service-to-service; phai khac JWT_SECRET.
INTERNAL_RPC_TOKEN=change-this-to-another-long-random-service-token

# Tuy chon cho cac flow tich hop ben ngoai.
MAIL_USERNAME=
MAIL_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
